{
  "name": "element-chemistry-quiz",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "data:equations": "python tools/build_equation_quiz_data.py",
    "test": "npm run build && node --test tests/*.test.mjs",
